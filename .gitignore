# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==================== TRAE / 本地草稿 ====================
# TRAE documents and memory (private)
.trae/
# 本地 AI 工具缓存与草稿目录(不参与构建)
.codex/
py/

# ==================== Test / Temp ====================
# Test directories
mp4-test/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Cover cache directory
.cover_cache/

