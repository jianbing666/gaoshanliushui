{
  "name": "gaoshanliushui",
  "version": "1.3.0",
  "description": "高山流水 - 一款优雅的本地音乐播放器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf:snapshot": "node scripts/perf-snapshot.mjs",
    "perf:gate": "node scripts/perf-gate.mjs",
    "perf:runtime": "node scripts/perf-runtime.mjs"
  },
  "dependencies": {
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "marked": "^14.1.3",
    "pinia": "^2.3.0",
    "tauri-plugin-media-api": "^0.1.1",
    "vue": "^3.5.13",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  },
  "author": "Bilibili Music Lover",
  "license": "MIT"
}
